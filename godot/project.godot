config_version=5

[application]
config/name="RPG Maker"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icons/character.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=840
window/size/window_width_override=1280
window/size/window_height_override=840
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.065, 1)

[audio]
general/text_to_speech=true
