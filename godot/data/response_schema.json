    "storyText": {
      "type": "STRING",
      "description": "A continuação da história."
    },
    "location": {
      "type": "STRING",
      "description": "A localização atual do personagem. Inclua sempre."
    },
    "gameTime": {
      "type": "OBJECT",
      "description": "Atualizações no tempo do jogo.",
      "properties": {
        "hour": {
          "type": "INTEGER"
        },
        "minute": {
          "type": "INTEGER"
        },
        "day": {
          "type": "INTEGER"
        },
        "month": {
          "type": "INTEGER"
        },
        "year": {
          "type": "INTEGER"
        }
      }
    },
    "playerStatus": {
      "type": "OBJECT",
      "description": "Atualizações no status do jogador. Apenas inclua se houver alterações.",
      "properties": {
        "health": {
          "type": "INTEGER"
        },
        "maxHealth": {
          "type": "INTEGER"
        },
        "mana": {
          "type": "INTEGER"
        },
        "maxMana": {
          "type": "INTEGER"
        },
        "energy": {
          "type": "INTEGER"
        },
        "maxEnergy": {
          "type": "INTEGER"
        },
        "sanity": {
          "type": "INTEGER",
          "description": "(Gênero Terror) A sanidade atual do jogador."
        },
        "description": {
          "type": "STRING"
        },
        "title": {
          "type": "STRING"
        },
        "fame": {
          "type": "STRING"
        },
        "level": {
          "type": "INTEGER"
        },
        "experience": {
          "type": "INTEGER"
        },
        "maxExperience": {
          "type": "INTEGER"
        },
        "skillPoints": {
          "type": "INTEGER",
          "description": "(Gênero Isekai) Pontos de habilidade para distribuir."
        },
        "gold": {
          "type": "INTEGER",
          "description": "(Gênero Arena) A quantidade de ouro do jogador."
        }
      }
    },
    "inventory": {
      "type": "ARRAY",
      "description": "Lista de NOVOS itens REALMENTE adquiridos na narrativa deste turno (encontrados em baús, pegos de inimigos, recebidos de NPCs). NÃO adicione itens que o jogador apenas 'imaginou' ter ou que não foram explicitamente dados a ele.",
      "items": {
        "type": "OBJECT",
        "properties": {
          "name": {
            "type": "STRING"
          },
          "description": {
            "type": "STRING"
          },
          "type": {
            "type": "STRING",
            "enum": [
              "Arma",
              "Armadura",
              "Consumível",
              "Missão",
              "Chave",
              "Outro"
            ]
          },
          "quantity": {
            "type": "INTEGER"
          },
          "damage": {
            "type": "STRING",
            "description": "O dano da arma, se o item for do tipo 'Arma'."
          },
          "starSlots": {
            "type": "INTEGER",
            "description": "Quantidade máxima de estrelas do item (1 a 10); padrão 5."
          },
          "stars": {
            "type": "INTEGER",
            "description": "Estrelas atuais (0 até starSlots)."
          }
        }
      }
    },
    "skills": {
      "type": "ARRAY",
      "description": "Lista de NOVAS habilidades ou magias aprendidas. Para o gênero Isekai, use as categorias apropriadas. Sempre inclua 'level' e 'maxLevel'.",
      "items": {
        "type": "OBJECT",
        "properties": {
          "name": {
            "type": "STRING"
          },
          "description": {
            "type": "STRING"
          },
          "category": {
            "type": "STRING",
            "enum": [
              "Habilidades Passivas de Raça",
              "Habilidades Físicas de Classe",
              "Habilidades Passivas Físicas de Classe",
              "Habilidades Mágicas de Classe",
              "Habilidades Passivas Mágicas de Classe",
              "Habilidades Físicas Aprendidas",
              "Habilidades Mágicas Aprendidas",
              "Magia"
            ]
          },
          "damage": {
            "type": "STRING",
            "description": "O dano da habilidade, se aplicável."
          },
          "cost": {
            "type": "INTEGER",
            "description": "O custo de recurso da habilidade, se aplicável."
          },
          "costType": {
            "type": "STRING",
            "enum": [
              "Mana",
              "Energia"
            ],
            "description": "O tipo de recurso consumido."
          },
          "level": {
            "type": "INTEGER",
            "description": "O nível inicial da habilidade (geralmente 1)."
          },
          "maxLevel": {
            "type": "INTEGER",
            "description": "O nível máximo que a habilidade pode atingir."
          }
        }
      }
    },
    "bestiary": {
      "type": "ARRAY",
      "description": "Registre somente nome e observações visíveis. Nunca revele atributos exatos por mero avistamento. Descobertas fundamentadas usam bestiaryDiscoveries.",
      "items": {
        "type": "OBJECT",
        "properties": {
          "name": {
            "type": "STRING"
          },
          "description": {
            "type": "STRING",
            "description": "A descrição base da criatura."
          },
          "knownInfo": {
            "type": "OBJECT",
            "properties": {
              "health": {
                "type": "STRING",
                "description": "Descrição da vitalidade (ex: 'Baixa', 'Média', 'Alta')."
              },
              "mana": {
                "type": "STRING",
                "description": "Descrição da energia mágica (ex: 'Nenhuma', 'Reserva arcana profunda')."
              },
              "weaknesses": {
                "type": "ARRAY",
                "items": {
                  "type": "STRING"
                }
              },
              "abilities": {
                "type": "ARRAY",
                "items": {
                  "type": "STRING"
                }
              },
              "loot": {
                "type": "ARRAY",
                "items": {
                  "type": "STRING"
                },
                "description": "Itens que podem ser obtidos da criatura."
              },
              "habitat": {
                "type": "STRING"
              },
              "lore": {
                "type": "STRING",
                "description": "História ou fatos interessantes sobre a criatura."
              }
            }
          }
        }
      }
    },
    "allies": {
      "type": "ARRAY",
      "description": "Lista de NOVOS aliados que se juntaram ao jogador.",
